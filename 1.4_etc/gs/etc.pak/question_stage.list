#FORM2

#系统设置
[config]
#玩家最低等级限制
req_level: 10

#菜单NPC
npc: 天墉城考官

#题目组分类
group: ({ "easy", "expert" })

#易题组设置
[easy]
#关卡总数
total_stages: 4

#每关卡的题目数
question_number_per_stage: 2

#关卡1的选题难度
question_type_stage_1: ({ "A" })
#奖励
bonus_stage_1: ({ 800, "easy_bonus_stage_1_1", 100, "easy_bonus_stage_1_2", 50, "easy_bonus_stage_1_3", 10, "easy_bonus_stage_1_4", "做得很好，你得到了#R$ITEM_LIST#n。" })

#关卡2的选题难度
question_type_stage_2: ({ "B" })
#奖励
bonus_stage_2: ({ 800, "easy_bonus_stage_2_1", 100, "easy_bonus_stage_2_2", 50, "easy_bonus_stage_2_3", 10, "easy_bonus_stage_2_4", "做得很好，你得到了#R$ITEM_LIST#n。" })

#关卡3的选题难度
question_type_stage_3: ({ "C" })
#奖励
bonus_stage_3: ({ 2000, "easy_bonus_stage_3_1", 50, "easy_bonus_stage_3_2", 50, "easy_bonus_stage_3_3", "恭喜你，获得了#R$ITEM_LIST#n。" })

#关卡4的选题难度
question_type_stage_4: ({ "D" })
#奖励
bonus_stage_4: ({ 6000, "easy_bonus_stage_4_1", 6000, "easy_bonus_stage_4_2", 200, "easy_bonus_stage_4_3", 200, "easy_bonus_stage_4_4", 5, "easy_bonus_stage_4_5", 200, "easy_bonus_stage_4_6", 10, "easy_bonus_stage_4_7", 4, "easy_bonus_stage_4_8", 200, "easy_bonus_stage_4_9", 210, "easy_bonus_stage_4_10", "你真的是天才哦!获得了#R$ITEM_LIST#n。" })

