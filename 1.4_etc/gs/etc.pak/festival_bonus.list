#FORM2

# Created by tangy  9-26-2006
# 格式：

# [FD123456]                                // 节日编号
# fname : "节日名"                          // 节日名
# save_path : xxx                           // 绑定到玩家身上的字段名
# bonus_info$: ({ "time", "对应奖励" })     // 时间和对应奖励

# [对应奖励]
# bonus$: ({ .... })                        // 参考 SBONUS_D 的文档


#####################################################################################
#  以下是为调用SBONUS_D接口所准备的奖励信息
#  SBONUS_D 已经修改，支持串式的表达式值解析
#####################################################################################

[宝盒类型]
name$: 招财进宝
name$: 吉祥如意
name$: 金玉满堂
min_level: "玩家等级"
max_level: "玩家等级"

[宝宝玲珑丹类型]
name$: 宝宝玲珑丹
min_level: "玩家等级 - 20"
max_level: "玩家等级 - 20"
color_desc : ""

[炼妖石类型]
name$: 炼妖石
min_level: "玩家等级 / 10 - 2 < 6"
max_level: "玩家等级 / 10 - 2 < 6"

[装备类型]
color$: 金色
scan_min_level: "玩家等级 - 5 < 100"
scan_max_level: "玩家等级 + 5 < 100"

[男类型]
name$: 玫瑰
gender: 男
color_desc : ""
default_color_desc: ""

[女类型]
name$: 巧克力
gender: 女
color_desc : ""
default_color_desc: ""

#####################################################################################
#  以下是节日配置相关信息
color_desc : ""
color_desc : ""
color_desc : ""
#####################################################################################

