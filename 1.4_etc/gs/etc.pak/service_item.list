#FORM2

#[xx]: 物品关键名称
#基本信息：
#name: 物品显示名字
#desc: 物品描述
#icon: 物品编号
#combined: 物品是否能够叠加(1可以, 0不可以)
#unit:  单位
#value: 物品价格

#服务内容
#service_way: 使用/携带(使用后获得服务的，可以不写；
#                       携带后就获得服务的，则一定要填写)
#service_list$: ({ 提供的服务名称, 服务效果 })

[会员卡]
#基本信息
name: "道具套餐卡"
