#FORM2
#################################################################################
# [地图名]
#
# alias  : 该地图对应的文件名
# map_id : 该地图的图档编号
# npc_guide_index: 该地图NPC精灵索引
# compact_map_index: 该地图小地图的索引
#
# exits$ : ({ 连通地图, 传送点X坐标, 传送点Y坐标,
#             传送点图标（方向为箭头，切换房间时使用；CIRCLE为圆形）,
#             传送后X坐标, 传送后Y坐标, 传送后人物朝向,
#             区域名称（跨区域移动时务必填写） })
#
# npc$   : ({ NPC文件名, X坐标, Y坐标, NPC朝向, 优先级, 名字 })
# 优先级: NPC精灵显示时的优先级，数字越大，显示越靠后
# 名字:   NPC的中文名
#
# monster_list : ({ 怪物文件名 })
#
# template     : ({ 支持模版名 })
#
# family       : FAMILY_YUZHUDONG 门派遇敌
#
# p_touch_monster : 该地图是否可以遇敌（1 可以；0 不可以）
# p_auto_touch : 该地图是否可以使用自动遇敌功能（1 可以；0 不可以）
#
#################################################################################

