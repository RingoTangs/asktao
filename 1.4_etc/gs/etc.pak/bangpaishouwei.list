#FORM2

#bangpai_shouwei.list
#Created by llch 8/1/2006
#帮派守卫配置文件

#帮派等级说明：
#初级帮派: 1
#中级帮派: 2
#高级帮派: 3
#顶级帮派: 4

#字段说明
#[x] x为帮派等级
#interval: 帮派守卫的持续时间（秒）
#broadcast_interval: 广播时间（秒）
#cost_money: 开启帮派守卫需要耗费的帮派资金
#cost_construct: 开启帮派守卫需要耗费的帮派建设度
#req_money: 开启帮派守卫需要的最少帮派资金
#req_construct: 开启帮派守卫需要的最少帮派建设度
#init_monster_amount: 活动开始初始刷新的怪物数量
#total_monster_amount: 整个活动中间刷新的怪物总数量

[1]
interval: 3600
broadcast_interval: 600
req_construct: 20000
req_money: 200000
cost_construct: 500
cost_money: 30000
init_monster_amount: 10
total_monster_amount: 20

[2]
