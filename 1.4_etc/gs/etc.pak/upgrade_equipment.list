#FORM2

# 超级晶石、超级灵石
[升级材料]
超级石头 : ({ "超级晶石", "超级灵石" })

#改造武器用
超级灵石 : ({ "超级灵石" })

#改造护甲用
超级晶石 : ({ "超级晶石" })

#装备对应的炼化材料
[武器]
绿色 : ({ "五色灵石", "超级灵石" })
金色 : ({ "五色灵石", "超级灵石" })
蓝色 : ({ "红灵石", "黄灵石", "蓝灵石", "绿灵石", "紫灵石", "超级灵石" })
粉色 : ({ "红灵石", "黄灵石", "蓝灵石", "绿灵石", "紫灵石", "超级灵石" })

[衣服]
绿色 : ({ "五色晶石", "超级晶石" })
金色 : ({ "五色晶石", "超级晶石" })
蓝色 : ({ "红晶石", "黄晶石", "蓝晶石", "绿晶石", "紫晶石", "超级晶石" })
粉色 : ({ "红晶石", "黄晶石", "蓝晶石", "绿晶石", "紫晶石", "超级晶石" })

[头盔]
绿色 : ({ "五色晶石", "超级晶石" })
金色 : ({ "五色晶石", "超级晶石" })
蓝色 : ({ "红晶石", "黄晶石", "蓝晶石", "绿晶石", "紫晶石", "超级晶石" })
粉色 : ({ "红晶石", "黄晶石", "蓝晶石", "绿晶石", "紫晶石", "超级晶石" })

[鞋子]
绿色 : ({ "五色晶石", "超级晶石" })
金色 : ({ "五色晶石", "超级晶石" })
蓝色 : ({ "红晶石", "黄晶石", "蓝晶石", "绿晶石", "紫晶石", "超级晶石" })
粉色 : ({ "红晶石", "黄晶石", "蓝晶石", "绿晶石", "紫晶石", "超级晶石" })
