#FORM2

[house_class_list]
house_class$: "single"
house_class$: "married"

[single]
zone_name   : 个人小区
type_path   : "house/house_type"
id_path     : "house/house_id"
save_path   : "house"
save_name   : "GID"
save_branch : ""
save_or_not : 1
store_name  : "single_house_store"

[married]
zone_name   : 夫妻小区
type_path   : "marriage/house"
id_path     : "marriage/house_id"
save_path   : "house"
save_name   : "MARRIAGE_GID"
save_branch : ""
save_or_not : 0
store_name  : "marry_store"

