#FORM2

#奖励相关的限制条件说明

#opened: 奖励开放与否的标志
#Format:
# opened: ({ 开放与否, 未开放时的提示 })
# 开放标志: 0/1 0表示不开放， 1表示开放

#start_time: 奖励开始时间限制
#Format:
# start_time: ({ 开始时间, 不满足条件时的提示 })
# 开始时间填0时，表示不限制开始时间

#end_time: 奖励结束时间限制
#Format:
# end_time: ({ 结束时间, 不满足条件时的提示 })
# 结束时间填0时，表示不限制结束时间

#free_bag: 满足条件需要的背包空闲格数
#Format:
# free_bag: ({ 需求的空闲背包格数, 不满足条件时的提示 })

#free_pet: 满足条件需要的空闲宠物个数
#Format:
# free_pet: ({ 需求的空闲宠物个数, 不满足条件时的提示 })

#req_flag: 角色身上的特殊标志限定
#Format:
# req_flag: ({ 特殊标志名, 满足条件的标记值, 获得奖励后标记改变值 })

#min_level: 最小等级限制
#Format:
# min_level : ({ 最小等级, 不满足条件时的提示 })

#max_level: 最大等级限制
#Format:
# max_level : ({ 最大等级, 不满足条件时的提示 })

#奖励的奖励内容说明
#奖励格式Format:
# bonus$: ({ 开始时间, 结束时间, 获得概率, 奖励类型, 最小数量, 最大数量 })
# 奖励类型："金钱", "潜能", "经验", "IP卡",
#           如果奖励类型为物品名时，表示奖励指定的物品
# 开始时间：为0时表示不限制开始时间
# 结束时间：为0时表示不限制结束时间
# 获得概率: 100％获得时为100，其他概率都是基于100的

#bonus_msg: 获得奖励以后的提示

#log_to_db: 指定的奖励发出时，将在数据库增加该奖励的LOG记录，以便统计

