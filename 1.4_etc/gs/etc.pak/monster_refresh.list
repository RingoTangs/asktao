#FORM2

#   1. 导入表文件格式 :
#
#   规则名      房间    坐标    偏差    类型     名称      数量    时间间隔
#   key_name    room    coor    range   type     name      amount  time
#
#   规则名(string)  :   规则的名字
#   房间(string)    :   /lanxianzheng/lanxianzheng.c
#   坐标(array)     :   ({ }) 此房间内随机抽取坐标点
#                       ({ x1, y1, x2, y2, x3, y3 }) 在多个点刷怪
#   偏差(int)       :   坐标的偏差范围，不指定则为DEFAULT_RANGE(定义在MONSTER_REFRESH_D中)
#   类型(string)    :   怪物 或者 物品
#   名称(string)    :   青蛙
#   数量(int)       :   amount 为int时
#                       当 sizeof(坐标) > 0 且, sizeof(坐标) < amount 时, 给出提示,并自动将 amount 减少
#                       当 sizeof(坐标) > 0 且, sizeof(坐标) > amount 时, 随机从坐标中抽取地点
#   时间间隔(mixed) :   time 多长时间刷一次怪, 可以支持 string 通配
#                       如果 time 格式为 "100 ± 50" 表示 100 秒刷新一次，误差 50 秒
[卧龙坡BOSS]
room    :   "wolongpo/wolongpo"
coor    :   ({  })
type    :   怪物
name    :   羊头怪
amount  :   1
range   :   50
time    :   "28800 ± 3600"
clone_callback$ : ({ "set", "resist_fire",  75 })
clone_callback$ : ({ "set_polar", "POLAR_FIRE" })
clone_callback$ : ({ "set_full_skill", "xinghuo-liaoyuan" })
clone_callback$ : ({ "set_full_skill", "yantian-huoyu" })
clone_callback$ : ({ "set_full_skill", "fengchi-dianche" })
clone_callback$ : ({ "set_full_skill", "hunqian-mengying" })

