#FORM2

#Create by Caijz NOv/10/2006
#工资配置表

#period 前一个代表月，后一个代表天，如一月一天写成({ 1, 1 })
#start 代表第一次发工资的时间
#duration 单位天,发工资的持续时间，只发一天为0，即当天发
#min_level 能够领工资的最小等级
#min_time 单位秒，能够领工资的最短在线时间

#period_start_time 一个新工资周期的起点，以月为周期的一般定为1号，
# 周为周期的取刚好是周一的号就可以了
# 注意这个与工资周期配合计算玩家一个工资周期的开始时间和结束时间

[设置]
period    : ({ 1, 0 })
start     : "2007-03-01"
duration  : 4
min_level : 60
min_time  : 216000
period_start_time : "2007-02-01"

[等级-工资]
#salary$ ：({ 最低等级，最高等级，扣除荣誉，工资 })
salary$ : ({ 0,   59,  0,    0 })
salary$ : ({ 60,  69,  7500, 500 })
salary$ : ({ 70,  79,  7500, 1000 })
salary$ : ({ 80,  89,  7500, 2000 })
salary$ : ({ 90,  99,  7500, 3000 })
salary$ : ({ 100, 109, 7500, 4000 })
salary$ : ({ 110, 119, 7500, 5000 })
salary$ : ({ 120, 129, 7500, 6000 })
salary$ : ({ 130, 180, 7500, 7000 })

#领取的工资百分比树
[时间-工资百分比]
#当时间为负数的时候表示这个时间是无穷大，时间单位小时
#percent$ ：({ 最短时间，最长时间， 领百分比工资})
percent$ : ({ 0,   59,  0 })
percent$ : ({ 60,  89,  25 })
percent$ : ({ 90,  119, 50 })
percent$ : ({ 120, -1,  100 })
