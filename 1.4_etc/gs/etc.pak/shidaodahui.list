#试道大会配置文件

[传送坐标]
#回天墉城: ({ X坐标, Y坐标 })
回天墉城: ({ 374, 149 })

#去试道场: ({ X坐标, Y坐标, 半径 })
去试道场: ({ 101, 76, 15  })

#[XX]: XX为比赛分组
#signup_time: 比赛的报名时间（目前没有使用）
#start_time : 比赛的开始时间
#end_time   : 比赛的结束时间

[match_list]
match$: "60-69"
match$: "70-79"
match$: "80-89"
match$: "90-99"
match$: "100-109"
match$: "110以上"

#broadcast:             比赛开始广播到开始报名的间隔时间（秒）
#signup:                比赛开始报名到比赛开始的间隔时间（秒）
#monster_rate:          怪物数量对参赛人数的比率（基于100）
#initial_monster_rate:  初始怪物数量对参赛人数的比率（基于100）
#player_minimum:        参赛的最小人数
#start_time:            比赛开始时间
#duration:              比赛的持续时间（秒）
#broadcast_stop:        比赛结束前广播到比赛结束的间隔时间（秒）
#title:                 获得比赛胜利后的头衔
#level:                 指定比赛要求的玩家级别范围
#step_rate:             走动遇怪系数（基于100）

[60-69]
level: ({ 60, 69 })
broadcast:              1800
signup:                 600
monster_rate:           200
initial_monster_rate:   25
player_minimum:         20
start_time$:            "周4-20:00:00"
duration:               10800
broadcast_stop:         600
title:                  试道王者
step_rate:              50

