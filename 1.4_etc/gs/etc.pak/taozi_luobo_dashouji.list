# 化妆舞会（游戏模式）配置

[活动时间]
time_list$ : ({ "2008-01-14-18:00:00", "EVERY_HOUR(2)", "EVERY_WEEK(1)" })

[游戏启动前]

启动前定时时刻$ : 1200
启动前定时时刻$ : 900
启动前定时时刻$ : 600
启动前定时时刻$ : 300
广播频道        : "CHANNEL_SYSTEM"
广播内容        : "#R化妆舞会#n即将开始，#R天墉城（11，192）#n的#Y千面怪#n即将发布#R萝卜桃子大收集#n任务，所有玩家都可以找#Y千面怪#n领取任务。"

[游戏进行时]
广播频道        : "CHANNEL_SYSTEM"
广播内容        : "#R化妆舞会#n活动#R萝卜桃子大收集#n开始了！#R桃柳林#n出现了很多的#R桃树#n，#R官道北#n出现了很多的#R萝卜#n，大家快来找#Y千面怪#n变身之后，就可以采集了！""

[游戏进行中]
