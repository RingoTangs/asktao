# extra_attrib.list
# 额外属性的范围值
# 注：如果影响字段为空，表示影响的字段名是：prop/属性名
# 注：power字段同时对应 phy_power & mag_power
# 注：all_polar、all_resist等字段表示同时对应 5 种相性
# 注：metal、wood、water、fire、earth 可以加到任何装备上
# xx_skill 效果对应的是某项技能（如果是武器则必须是本系列的技能）

# 以下这些字段都是标准值的百分比
# 所谓标准值的含义对各个字段来说是不一样的
# power 的标准值是本类装备的标准攻击
# life  的标准值是本类装备的标准血量
# mana  的标准值是本类装备的标准法力
# speed 的标准值是本类装备的标准速度
# str、con、wiz、dex 的标准值是和等级线形相关的
#
# 属性名                          最小等级  最大等级  最小值  标称值  最大值  几率  不需要公式调整 影响字段
max_durability,                   10,       180,      5%,     10%,    20%,    500,  0,
power,                            10,       180,      5%,     30%,    70%,    500,  0,            phy_power|mag_power
def,                              10,       180,      25%,    55%,    95%,    500,  0,
max_life,                         10,       180,      25%,    50%,    85%,    500,  0,
max_mana,                         10,       180,      15%,    30%,    66%,    500,  0,
speed,                            10,       180,      15%,    30%,    67%,    500,  0,
str,                              10,       180,      10%,    15%,    25%,    500,  1,
con,                              10,       180,      10%,    15%,    25%,    500,  1,
wiz,                              10,       180,      10%,    15%,    25%,    500,  1,
dex,                              10,       180,      10%,    15%,    25%,    500,  1,
all_attrib,                       10,       180,      5%,     10%,    20%,    200,  1,

# 以下这些字段都是绝对值
# 注：某些值如命中率和反震率虽然表达的是比例，但是作为属性来说，
# 他们只是一个普通的数值，所以和上面字段不同，并不需要 %
# 属性名                          最小等级  最大等级  最小值  标称值  最大值  几率  不需要公式调整 影响字段
accurate,                         10,       180,      10,     20,     40,     500,  0,
double_hit_rate,                  10,       180,      10,     20,     30,     500,  0,
counter_attack_rate,              10,       180,      10,     20,     30,     500,  0,
stunt_rate,                       10,       180,      10,     20,     30,     500,  0,
damage_sel_rate,                  10,       180,      10,     20,     30,     500,  0,
double_hit,                       10,       180,      1,      2,      12,     500,  0,
counter_attack,                   10,       180,      1,      3,      10,     500,  0,
damage_sel,                       10,       180,      10,     20,     30,     500,  0,
metal,                            10,       180,      1,      1,      5,      300,  0,
wood,                             10,       180,      1,      1,      5,      300,  0,
water,                            10,       180,      1,      1,      5,      300,  0,
fire,                             10,       180,      1,      1,      5,      300,  0,
earth,                            10,       180,      1,      1,      5,      300,  0,
resist_metal,                     10,       180,      5,      8,      15,     400,  0,
resist_wood,                      10,       180,      5,      8,      15,     400,  0,
resist_water,                     10,       180,      5,      8,      15,     400,  0,
resist_fire,                      10,       180,      5,      8,      15,     400,  0,
resist_earth,                     10,       180,      5,      8,      15,     400,  0,
resist_poison,                    10,       180,      5,      10,     20,     400,  0,
resist_frozen,                    10,       180,      5,      10,     20,     400,  0,
resist_sleep,                     10,       180,      5,      10,     20,     400,  0,
resist_forgotten,                 10,       180,      5,      10,     20,     400,  0,
resist_confusion,                 10,       180,      5,      10,     20,     400,  0,
all_polar,                        60,       180,      1,      1,      5,      100,  0,
all_resist_polar,                 10,       180,      5,      8,      15,     200,  0,
all_resist_except,                10,       180,      5,      8,      15,     200,  0,
all_skill,                        20,       180,      1,      2,      10,     100,  0,
#xx_skill_improved,               10,       180,      1,      1,      3,      400,  0,
#xx_skill_low_cost,               10,       180,      1,      1,      3,      400,  0,
penetrate,                        10,       180,      10,     20,     40,     50,   0,

